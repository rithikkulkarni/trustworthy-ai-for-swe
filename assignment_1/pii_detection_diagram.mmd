flowchart TD
    A["A Java file's source text"] --> B["Look at the file one line at a time"]

    B --> C1 & C2 & C3 & C4 & C5 & C6

    subgraph C1["Email addresses"]
        direction TB
        C1a["Spot anything shaped like an email"] --> C1b{"Is it a known placeholder?<br/>(example.com, test@..., etc.)"}
        C1b -- yes --> C1x["Ignore it"]
        C1b -- no --> C1y["Flag as a real email"]
    end

    subgraph C2["IP addresses"]
        direction TB
        C2a["Spot anything shaped like an IPv4 address"] --> C2b{"Is it a placeholder address?<br/>(loopback, 0.0.0.0, etc.)"}
        C2b -- yes --> C2x["Ignore it"]
        C2b -- no --> C2y["Flag it<br/>(private network addresses still count)"]
    end

    subgraph C3["API keys / tokens"]
        direction TB
        C3a["Match a known provider's key format<br/>(AWS, Google, GitHub, Slack)"] --> C3y1["Flag it immediately<br/>(these formats are unmistakable)"]
        C3b["Or spot a generic 'key = ...' assignment"] --> C3c{"Does the value actually look<br/>like a real secret?<br/>(long, random-looking, mixed characters)"}
        C3c -- no --> C3x["Ignore it<br/>(probably a placeholder like 'changeme')"]
        C3c -- yes --> C3y2["Flag it"]
    end

    subgraph C4["Passwords"]
        direction TB
        C4a["Spot a 'password = ...' assignment<br/>or a database connection string"] --> C4b{"Is it a placeholder,<br/>or too simple to be real?"}
        C4b -- yes --> C4x["Ignore it"]
        C4b -- no --> C4y["Flag it"]
    end

    subgraph C5["Usernames / handles"]
        direction TB
        C5a["Spot a 'username = ...' assignment"] --> C5c{"Is it a placeholder value,<br/>or actually an email?"}
        C5b["Or spot a handle-like word<br/>next to an author credit"] --> C5d{"Is it a generic placeholder?"}
        C5c -- no --> C5y1["Flag it"]
        C5c -- yes --> C5x1["Ignore it"]
        C5d -- no --> C5y2["Flag it"]
        C5d -- yes --> C5x2["Ignore it"]
    end

    subgraph C6["Personal names"]
        direction TB
        C6a{"Does this line credit an author?<br/>(@author, 'created by', etc.)"}
        C6a -- no --> C6x0["Don't even look for names here"]
        C6a -- yes --> C6b["Look for a First-Last name shape"]
        C6b --> C6c{"Is it a known non-name phrase?<br/>('Open Source', 'Software Foundation', ...)"}
        C6c -- yes --> C6x["Ignore it"]
        C6c -- no --> C6y["Flag it as a real name"]
    end

    C1y & C2y & C3y1 & C3y2 & C4y & C5y1 & C5y2 & C6y --> D["Everything flagged so far<br/>(with the surrounding text redacted)"]

    D --> E{"Was LLM double-checking requested?"}
    E -- no --> J["Final candidate list"]

    E -- yes --> F["Pull out only the ambiguous types:<br/>names, usernames, emails<br/>(passwords/keys/IPs never leave the machine)"]
    F --> G["Send them all together in one batch"]
    G --> H["Ask Gemini 3.5 Flash-Lite:<br/>'is this really a specific person's info,<br/>or something that just looks like it?'"]
    H --> I["Attach the model's yes/no + confidence<br/>to each candidate<br/>(this only adds a second opinion,<br/>it doesn't remove anything)"]
    I --> I2["Track token usage and cost"]
    I2 --> J

    J --> K["Summarize results:<br/>counts by type, what rule caught each one,<br/>the LLM's cost and opinions, example cases"]
    K --> L["candidates.jsonl + a readable report"]
